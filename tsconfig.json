{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"]
    },
    "types": ["@shopify/oxygen-workers-types"]
  },
  "include": ["app/**/*", "tests/**/*", "env.d.ts", ".react-router/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
