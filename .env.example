# Generated by `npx shopify hydrogen link` + `env pull`, or injected by Oxygen at runtime.
SESSION_SECRET=""
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
SHOP_ID=""

# Keep direct Meta disabled while Shopify's Facebook & Instagram integration
# owns browser/server events. The custom Meta bridge has no shared event IDs
# for deduplication.
PUBLIC_CUSTOM_META_ENABLED="false"

# Enables only Hydrogen storefront `view_item` and `add_to_cart` events. The
# component suppresses automatic page views and leaves checkout events to
# Shopify's native Google integration.
PUBLIC_GA4_STOREFRONT_EVENTS_ENABLED="false"

# Optional custom Meta Pixel ID. Used only when direct Meta is enabled.
PUBLIC_FACEBOOK_PIXEL_ID=""

# Optional custom GA4 Measurement ID. Used only for storefront events.
PUBLIC_GA4_MEASUREMENT_ID=""

# Free-shipping threshold (in the store's currency units, not cents).
# The cart-drawer progress bar reads this to decide when to show the
# "Add $X for free shipping" copy. Default is 75. Update this single
# value to change the threshold everywhere it's shown.
PUBLIC_FREE_SHIPPING_THRESHOLD="75"
