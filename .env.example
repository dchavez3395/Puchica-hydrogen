# Generated by `npx shopify hydrogen link` + `env pull`, or injected by Oxygen at runtime.
SESSION_SECRET=""
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
SHOP_ID=""

# Leave false while Shopify's Facebook & Instagram and Google & YouTube app
# pixels are connected under Settings > Customer events. Enable custom analytics
# only after those native pixels are intentionally disconnected; otherwise the
# same commerce events can be counted twice.
PUBLIC_CUSTOM_ANALYTICS_ENABLED="false"

# Optional custom Meta Pixel ID. Used only when custom analytics is enabled.
PUBLIC_FACEBOOK_PIXEL_ID=""

# Optional custom GA4 Measurement ID. Used only when custom analytics is enabled.
PUBLIC_GA4_MEASUREMENT_ID=""

# Free-shipping threshold (in the store's currency units, not cents).
# The cart-drawer progress bar reads this to decide when to show the
# "Add $X for free shipping" copy. Default is 75. Update this single
# value to change the threshold everywhere it's shown.
PUBLIC_FREE_SHIPPING_THRESHOLD="75"
