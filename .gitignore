# ─── Generated types ─────────────────────────────────────────
# Auto-generated by `shopify hydrogen codegen`. Regenerated on
# `npm run codegen` — never hand-edit.
storefrontapi.generated.d.ts
# Same generator, same reason. This one was tracked by mistake and showed as
# modified on every checkout from line endings alone, with no content change,
# which made every pre-flight `git status` noisy.
customer-accountapi.generated.d.ts

